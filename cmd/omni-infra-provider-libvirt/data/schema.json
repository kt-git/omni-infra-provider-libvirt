{
  "type": "object",
  "properties": {
    "cores": {
      "type": "integer",
      "minimum": 1,
      "default": 2
    },
    "memory": {
      "type": "integer",
      "minimum": 2048,
      "default": 4096,
      "description": "Memory size MiB"
    },
    "disk_size": {
      "type": "integer",
      "minimum": 10,
      "default": 20,
      "description": "Disk size in GiB"
    },
    "storage_pool": {
      "type": "string",
      "default": "default",
      "description": "libvirt storage pool name"
    },
    "graphics": {
      "type": "string",
      "enum": [
        "vnc",
        "spice",
        "none"
      ],
      "default": "vnc",
      "description": "Graphics device type."
    },
    "additional_disks": {
      "type": "array",
      "description": "List of secondary disks.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "default": "nvme",
            "enum": [
              "sata",
              "nvme"
            ]
          },
          "size": {
            "type": "integer",
            "format": "uint64",
            "minimum": 10,
            "default": 20,
            "description": "Disk size in GiB"
          }
        },
        "required": [
          "type",
          "size"
        ]
      }
    },
    "network_interfaces": {
      "type": "array",
      "description": "List of network interfaces.",
      "default": [
        {
          "driver": "virtio",
          "network_name": "default"
        }
      ],
      "items": {
        "type": "object",
        "properties": {
          "driver": {
            "type": "string",
            "enum": [
              "virtio",
              "e1000e",
              "e1000"
            ],
            "default": "virtio"
          },
          "physical_address": {
            "type": "string",
            "description": "Deprecated alias of mac."
          },
          "network_name": {
            "type": "string",
            "description": "libvirt network name (type network). Must exist, the provider will not create it."
          },
          "type": {
            "type": "string",
            "enum": [
              "network",
              "bridge",
              "direct"
            ],
            "default": "network",
            "description": "How the NIC is attached: libvirt network (network_name), existing host bridge (bridge) or macvtap on a host interface (device)."
          },
          "bridge": {
            "type": "string",
            "description": "Existing host Linux bridge name (type bridge), e.g. br0."
          },
          "device": {
            "type": "string",
            "description": "Host interface for macvtap (type direct)."
          },
          "mode": {
            "type": "string",
            "enum": [
              "bridge",
              "vepa",
              "private",
              "passthrough"
            ],
            "description": "macvtap mode (type direct), default bridge."
          },
          "mac": {
            "type": "string",
            "description": "MAC address. If empty, a stable MAC is derived from the machine UUID and NIC index."
          },
          "dhcp4": {
            "type": "boolean",
            "description": "Guest DHCPv4 on this NIC. Defaults to true unless addresses are set."
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Static guest addresses in CIDR form."
          },
          "gateway": {
            "type": "string",
            "description": "Guest gateway for this NIC."
          },
          "nameservers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Guest DNS servers for this NIC."
          }
        },
        "required": [
          "driver"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "bridge"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "bridge"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "direct"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "device"
              ]
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "not": {
                    "required": [
                      "type"
                    ]
                  }
                },
                {
                  "properties": {
                    "type": {
                      "const": "network"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "network_name"
              ]
            }
          }
        ]
      }
    },
    "pci_hostdevs": {
      "type": "array",
      "description": "Optional PCI devices to pass through with VFIO (libvirt hostdev). Leave the guest virtio-vga in place and attach the device as a secondary GPU. Address is a sysfs BDF such as 0000:00:02.0.",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "PCI address in sysfs form, e.g. 0000:00:02.0."
          },
          "romfile": {
            "type": "string",
            "description": "Optional ROM file path on the host, if a dumped VBIOS is required."
          },
          "rombar": {
            "type": "boolean",
            "description": "Whether to expose a ROM BAR. Defaults to true. Some IGD devices need this set false."
          },
          "managed": {
            "type": "boolean",
            "description": "Let libvirt bind/unbind vfio-pci. Defaults to true."
          }
        },
        "required": [
          "address"
        ]
      }
    }
  },
  "required": [
    "cores",
    "memory",
    "disk_size",
    "storage_pool"
  ]
}
